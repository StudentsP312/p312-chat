JWT_SECRET=super_secret_jwt_key_for_development_replace_in_prod
REDIS_URL=redis://localhost:6379/0

# PostgreSQL Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=chat_user
POSTGRES_PASSWORD=chat_secret
POSTGRES_DB=chat_db

# Или единый DSN:
# DATABASE_URL=postgresql+asyncpg://chat_user:chat_secret@localhost:5432/chat_db

# S3 Object Storage (MinIO для локальной разработки / Cloud.ru S3 для продакшна)
S3_BUCKET=chat-bucket
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION_NAME=us-east-1
S3_PUBLIC_BASE_URL=http://localhost:9000/chat-bucket
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
HEALTH_CHECK_S3=true

# Rate Limits & Cache
RATE_LIMIT_SECONDS=5.0
MAX_CONSECUTIVE_SAME_MESSAGES=2
SPAM_TTL_SECONDS=3600
MAX_TEXT_LENGTH=4000
MAX_FILE_SIZE=20971520
MESSAGE_CACHE_TTL_SECONDS=2
MESSAGE_RETENTION_DAYS=30
ACCESS_TOKEN_EXPIRE_MINUTES=1440